@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <!-- Meme de 700x700 -->
    <img src="/Images/meme-cuadrado-gato-vibrante-simple_742173-4493 (1).jpg" alt="Meme" width="700" height="700" class="my-4" />

    <!-- Campo de texto y botón -->
    <div class="mb-3">
        <input type="text" id="inputTexto" class="form-control form-control-lg w-50 mx-auto" placeholder="Escribe algo aquí..." />
    </div>
    <button type="button" class="btn btn-outline-success btn-lg" onclick="mostrarAlerta()">Mostrar Alerta</button>
</div>

@section Scripts {
    <script>
        function mostrarAlerta() {
            const valor = document.getElementById("inputTexto").value || "(Inventado)";
            alert(`Mi nombre es Esteban Cueva, mi curso es Programacion 4., mi hobbie es tocar el piano y el valor del campo de texto es: ${valor}`);
        }
    </script>
}
